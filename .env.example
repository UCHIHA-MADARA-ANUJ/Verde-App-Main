# ⚠️ Copy this file to .env.local and fill in your own keys.
# NEVER commit real API keys. The placeholders below are fake examples.

# Firebase Realtime Database
NEXT_PUBLIC_FIREBASE_HOST=your-project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_AUTH=your_firebase_secret_here

# Gemini API (for image chat)
NEXT_PUBLIC_GEMINI_KEY=your_gemini_api_key_here

# OpenWeather
NEXT_PUBLIC_OPENWEATHER_KEY=your_openweather_api_key_here

# OpenRouter
NEXT_PUBLIC_OPENROUTER_KEY=sk-or-v1-your_openrouter_key_here

# Plant.id / Crop.health (Kindwise)
NEXT_PUBLIC_PLANTID_KEY=your_kindwise_api_key_here

# CAM upload endpoint (your Vercel endpoint + key)
NEXT_PUBLIC_CAM_UPLOAD_API=https://your-app.vercel.app/api/upload-photo
NEXT_PUBLIC_CAM_API_KEY=your_cam_api_key_here
